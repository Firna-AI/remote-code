{
  "$schema": "./node_modules/knip/schema.json",
  "include": ["files", "exports", "types", "nsExports", "nsTypes"],
  "workspaces": {
    ".": {
      // Vite, Wrangler, Vitest, and package scripts supply their own entries.
      // These extra entries run directly or load by browser and framework conventions.
      "entry": [
        "src/**/dev/main.tsx",
        "src/files/markdown/markdown-worker.ts",
        "src/marketing/pages/**/*.astro",
        "tools/chatgpt-egress/proxy.ts",
        "worker/chatgpt-egress/index.ts",
        "image/*.mjs",
        "image/live-main.ts",
        "worker/chat/integration/run-browser-harness.mjs",
        "worker/chat/integration/browser-server.test-support.ts",
        "worker/chat/integration/*-entry.test-support.ts",
        "worker/devices/test-worker.test-support.ts",
        "worker/lifecycle/workspace-runtime-test-worker.ts",
        "worker/features/{entry,activity-entry,checkpoint-entry}.test-support.ts",
        "docs/mockups/src/entries/**/*.tsx",
        "docs/mockups/src/render.tsx",
        // Tests start these Workers by path.
        "worker/chat/device-cleanup-worker.test-support.ts",
        "worker/chat/runner-entry.test-support.ts",
        "worker/features/continue-entry.test-support.ts",
        "worker/github/sqlite-worker.test-support.ts",
        // The deploy bundles this file by path. Astro loads the content config.
        "worker/lifecycle/image-runtime.ts",
        "src/marketing/content.config.ts",
      ],
      // ts-rs writes one file for each Rust type, also for types that no
      // TypeScript code imports yet.
      "ignore": ["src/shared/generated/**"],
      "project": [
        "src/**/*.{ts,tsx,astro}",
        "worker/**/*.{ts,mjs}",
        "tools/**/*.ts",
        "image/*.{ts,mjs}",
        "docs/mockups/src/**/*.{ts,tsx}",
        "*.{ts,js}",
      ],
      "vite": {
        "config": ["vite.config.ts", "src/**/dev/vite.config.{ts,js}"],
      },
    },
    "desktop": {
      "entry": ["src/main.ts", "renderer/main.tsx", "scripts/*.ts"],
      "project": [
        "src/**/*.ts",
        "renderer/**/*.{ts,tsx}",
        "scripts/*.ts",
        "tests/**/*.ts",
        "*.ts",
      ],
      "includeEntryExports": true,
    },
    "runner/sdk-helper": {
      "entry": ["src/{main,measure,compare}.ts", "scripts/*.mjs"],
      "project": [
        "src/**/*.ts",
        "test-support/**/*.ts",
        "scripts/*.mjs",
        "*.ts",
      ],
      "includeEntryExports": true,
    },
  },
}
