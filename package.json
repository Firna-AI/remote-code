{
  "name": "remote-code",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "scripts": {
    "dev": "npm run site:build && vite",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "npm run site:build && vite build",
    "preview": "vite preview --port 5174",
    "types": "mkdir -p .wrangler && wrangler types .wrangler/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc -b tsconfig.json tsconfig.worker-tests.json && CI=true astro check --tsconfig tsconfig.site.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "exports:check": "knip",
    "check": "npm run check:static && npm run test",
    "check:static": "npm run typecheck && npm run desktop:typecheck && npm run runner:typecheck && npm run lint && npm run desktop:lint && npm run format:check && npm run desktop:format:check && npm run exports:check && npm run runner:test && npm run build:bundle && npm run mockups:check",
    "mockups:build": "mokly build --strict",
    "mockups:serve": "mokly serve",
    "mockups:typecheck": "tsc -p docs/mockups/tsconfig.json",
    "mockups:check": "npm run mockups:typecheck && npm run mockups:build",
    "marketing:pictures": "node tools/marketing-pictures/run.ts",
    "marketing:preview": "node tools/marketing-pictures/run.ts --preview-only",
    "site:dev": "astro dev",
    "site:build": "astro build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:lint": "npm --prefix desktop run lint",
    "desktop:format:check": "npm --prefix desktop run format:check",
    "runner:typecheck": "npm --prefix runner run typecheck",
    "runner:test": "npm --prefix runner run test"
  },
  "dependencies": {
    "@firna/ui": "4.0.0",
    "@lexical/react": "0.53.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "croner": "^11.0.0",
    "fflate": "^0.8.3",
    "lexical": "0.53.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "0.4.7",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@mokly/mokly": "0.19.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "astro": "^7.4.7",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.2",
    "miniflare": "5.20261101.0-beta",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
